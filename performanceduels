-- ═══════════════════════════════════════════════
--   УТИЛИТЫ
-- ═══════════════════════════════════════════════
local function GetChar() return L.Character end
local function GetHum()
    local c = GetChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function GetRoot()
    local c = GetChar()
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso"))
end

-- ═══════════════════════════════════════════════
--   ДВИЖЕНИЕ (безопасное через WalkSpeed)
-- ═══════════════════════════════════════════════
local function moveTo(targetPos, speed)
    local hum = GetHum()
    local root = GetRoot()
    if not hum or not root then return end
    
    -- WalkSpeed вместо Velocity
    hum.WalkSpeed = speed
    
    -- MoveDirection через Move()
    local dir = (Vector3.new(targetPos.X, root.Position.Y, targetPos.Z) - root.Position)
    if dir.Magnitude > 0.1 then
        hum:Move(dir.Unit, false)
    end
end

-- ═══════════════════════════════════════════════
--   ANTI-RAGDOLL
-- ═══════════════════════════════════════════════
local antiRagdollActive = true
local antiRagdollConn = nil

local function startAntiRagdoll()
    if antiRagdollConn then antiRagdollConn:Disconnect() end
    antiRagdollConn = R.Heartbeat:Connect(function()
        if not antiRagdollActive then return end
        local c = GetChar()
        if not c then return end
        local root = GetRoot()
        local hum = GetHum()
        if hum then
            local s = hum:GetState()
            if s == Enum.HumanoidStateType.Physics 
            or s == Enum.HumanoidStateType.Ragdoll 
            or s == Enum.HumanoidStateType.FallingDown then
                hum:ChangeState(Enum.HumanoidStateType.Running)
                if workspace.CurrentCamera then
                    workspace.CurrentCamera.CameraSubject = hum
                end
                pcall(function()
                    local pm = L.PlayerScripts:FindFirstChild("PlayerModule")
                    if pm then
                        require(pm:FindFirstChild("ControlModule")):Enable()
                    end
                end)
                if root then
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
        for _, obj in ipairs(c:GetDescendants()) do
            if obj:IsA("Motor6D") and not obj.Enabled then
                obj.Enabled = true
            end
        end
    end)
end

-- ═══════════════════════════════════════════════
--   UNWALK
-- ═══════════════════════════════════════════════
local unwalkActive = true
local unwalkConn = nil

local function startUnwalk()
    if unwalkConn then unwalkConn:Disconnect() end
    local hum = GetHum()
    if hum then
        local anim = hum:FindFirstChildOfClass("Animator")
        if anim then
            for _, t in pairs(anim:GetPlayingAnimationTracks()) do
                pcall(function() t:Stop(0) end)
            end
        end
    end
    unwalkConn = R.Heartbeat:Connect(function()
        if not unwalkActive then return end
        local h = GetHum()
        if not h then return end
        local a = h:FindFirstChildOfClass("Animator")
        if not a then return end
        for _, t in pairs(a:GetPlayingAnimationTracks()) do
            pcall(function() t:Stop(0) end)
        end
    end)
end

-- ═══════════════════════════════════════════════
--   ПОИСК ВРАГА
-- ═══════════════════════════════════════════════
local function findNearestEnemy()
    local c = L.Character
    if not c then return nil, nil end
    local r = c:FindFirstChild("HumanoidRootPart")
    if not r then return nil, nil end
    
    local nearest, nearestTorso = nil, nil
    local minDist = math.huge
    
    for _, p in ipairs(P:GetPlayers()) do
        if p ~= L and p.Character then
            local eh = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if eh and hum and hum.Health > 0 then
                local dist = (eh.Position - r.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nearest = eh
                    nearestTorso = p.Character:FindFirstChild("UpperTorso") 
                        or p.Character:FindFirstChild("Torso") 
                        or eh
                end
            end
        end
    end
    return nearest, nearestTorso
end

-- ═══════════════════════════════════════════════
--   ЭКИП БИТЫ
-- ═══════════════════════════════════════════════
local function equipBat()
    local c = L.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h then return end
    if c:FindFirstChild("Bat") then return end
    local bp = L:FindFirstChild("Backpack")
    if bp then
        for _, ch in ipairs(bp:GetChildren()) do
            if ch:IsA("Tool") and ch.Name == "Bat" then
                h:EquipTool(ch)
                break
            end
        end
    end
end

-- ═══════════════════════════════════════════════
--   БЕЗОПАСНЫЙ СВИНГ (без firetouchinterest)
-- ═══════════════════════════════════════════════
local function safeSwing()
    if tick() - LAST_ATTACK < 0.4 then return end
    LAST_ATTACK = tick()
    
    local c = L.Character
    if not c then return end
    local bat = c:FindFirstChild("Bat")
    if not bat then return end
    
    -- Просто Activate() — это не палево
    pcall(function()
        bat:Activate()
    end)
end

-- ═══════════════════════════════════════════════
--   AUTO LEFT (6 фаз)
-- ═══════════════════════════════════════════════
local autoLeftConn = nil
local autoLeftPhase = 1

local function startAutoLeft()
    if autoLeftConn then autoLeftConn:Disconnect() end
    autoLeftPhase = 1
    autoLeftConn = R.Heartbeat:Connect(function()
        if not S.AL then return end
        local char = L.Character
        if not char then return end
        local hrp = GetRoot()
        local hum = GetHum()
        if not hrp or not hum then return end
        
        if autoLeftPhase == 1 then
            local tg = Vector3.new(L_START.X, hrp.Position.Y, L_START.Z)
            if (tg - hrp.Position).Magnitude < 1 then
                autoLeftPhase = 2
            else
                moveTo(L_START, 59)
            end
        elseif autoLeftPhase == 2 then
            local tg = Vector3.new(L_END_PLUS.X, hrp.Position.Y, L_END_PLUS.Z)
            if (tg - hrp.Position).Magnitude < 1 then
                WAITING = true
                WAIT_START = tick()
                WAIT_SIDE = "LEFT"
                autoLeftPhase = 3
            else
                moveTo(L_END_PLUS, 29)
            end
        elseif autoLeftPhase == 3 then
            if tick() - WAIT_START >= WAIT_DUR then
                WAITING = false
                autoLeftPhase = 4
            end
        elseif autoLeftPhase == 4 then
            local tg = Vector3.new(L_BACK.X, hrp.Position.Y, L_BACK.Z)
            if (tg - hrp.Position).Magnitude < 1 then
                autoLeftPhase = 5
            else
                moveTo(L_BACK, 29)
            end
        elseif autoLeftPhase == 5 then
            local tg = Vector3.new(L_RETURN.X, hrp.Position.Y, L_RETURN.Z)
            if (tg - hrp.Position).Magnitude < 1 then
                autoLeftPhase = 6
            else
                moveTo(L_RETURN, 29)
            end
        elseif autoLeftPhase == 6 then
            local tg = Vector3.new(L_FINAL.X, hrp.Position.Y, L_FINAL.Z)
            if (tg - hrp.Position).Magnitude < 1 then
                S.AL = false
                autoLeftPhase = 1
                if autoLeftConn then autoLeftConn:Disconnect(); autoLeftConn = nil end
            else
                moveTo(L_FINAL, 29)
            end
        end
    end)
end

local function stopAutoLeft()
    if autoLeftConn then autoLeftConn:Disconnect(); autoLeftConn = nil end
    autoLeftPhase = 1
    WAITING = false
    local hum = GetHum()
    if hum then hum:Move(Vector3.zero, false) end
end

