local function createSquareButton(txt, y, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 85, 0, 70)
    btn.Position = UDim2.new(1, -100, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
    btn.BorderSizePixel = 0
    btn.Text = txt
    btn.TextColor3 = Color3.fromRGB(220, 220, 240)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.Parent = G
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 12)
    btnCorner.Parent = btn
    
    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = Color3.fromRGB(64, 128, 255)
    btnStroke.Thickness = 2
    btnStroke.Parent = btn
    
    local a = false
    btn.MouseButton1Click:Connect(function()
        a = not a
        btn.Text = txt
        btn.BackgroundColor3 = a and Color3.fromRGB(64, 128, 255) or Color3.fromRGB(30, 30, 45)
        btn.TextColor3 = a and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(220, 220, 240)
        callback(a)
    end)
    return btn
end

