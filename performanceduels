-- ═══════════════════════════════════════════════
--   DROP (безопасный — без флинга)
-- ═══════════════════════════════════════════════
local function doDrop()
    local char = GetChar()
    if not char then return end
    local root = GetRoot()
    if not root then return end
    
    -- Просто подпрыгиваем и падаем
    local hum = GetHum()
    if hum then
        hum.Jump = true
        task.wait(0.1)
        hum.Jump = false
    end
end

-- ═══════════════════════════════════════════════
--   TAUNT (чат)
-- ═══════════════════════════════════════════════
local function startTaunt()
    if tauntLoop then return end
    tauntLoop = task.spawn(function()
        while S.TN do
            pcall(function()
                local chat = game:GetService("TextChatService")
                local channel = chat.TextChannels:FindFirstChild("RBXGeneral")
                if channel then
                    channel:SendAsync("/performance duels")
                end
            end)
            task.wait(0.5)
        end
    end)
end

local function stopTaunt()
    if tauntLoop then
        task.cancel(tauntLoop)
        tauntLoop = nil
    end
end

-- ═══════════════════════════════════════════════
--   РУЧНОЕ ДВИЖЕНИЕ (отключение авто)
-- ═══════════════════════════════════════════════
local movementKeys = {
    Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
    Enum.KeyCode.Up, Enum.KeyCode.Left, Enum.KeyCode.Down, Enum.KeyCode.Right
}

local function checkPlayerMove()
    for _, key in ipairs(movementKeys) do
        if U:IsKeyDown(key) then return true end
    end
    return false
end

local function handleManualMovement()
    if checkPlayerMove() then
        if S.AL then
            S.AL = false
            LP = 1
            WAITING = false
            WAIT_SIDE = ""
            stopAutoLeft()
        end
        if S.AR then
            S.AR = false
            RP = 1
            WAITING = false
            WAIT_SIDE = ""
            stopAutoRight()
        end
    end
end

-- ═══════════════════════════════════════════════
--   ТЕЛЕПОРТ (проверка)
-- ═══════════════════════════════════════════════
local function checkTeleport()
    local c = L.Character
    if not c then return false end
    local r = c:FindFirstChild("HumanoidRootPart")
    if not r then return false end
    local currentPos = r.Position
    if lastPosition then
        local distance = (currentPos - lastPosition).Magnitude
        if distance > 50 then return true end
    end
    lastPosition = currentPos
    return false
end

-- ═══════════════════════════════════════════════
--   ГЛАВНЫЙ ЦИКЛ
-- ═══════════════════════════════════════════════
local function F()
    handleManualMovement()
    
    local c = L.Character
    if not c then return end
    local h = GetHum()
    local r = GetRoot()
    if not r or not h then return end
    
    if S.DR then
        doDrop()
        S.DR = false
    end
    
    if checkTeleport() then
        if S.AL then S.AL = false; LP = 1; stopAutoLeft() end
        if S.AR then S.AR = false; RP = 1; stopAutoRight() end
        WAITING = false
        WAIT_SIDE = ""
        return
    end
    
    if WAITING then
        if tick() - WAIT_START >= WAIT_DUR then
            WAITING = false
            if WAIT_SIDE == "LEFT" and S.AL then LP = 3 end
            if WAIT_SIDE == "RIGHT" and S.AR then RP = 3 end
            WAIT_SIDE = ""
        end
        return
    end
    
    -- LOCK BAT (безопасный аимбот)
    if S.LB then
        equipBat()
        local target, torso = findNearestEnemy()
        if target and torso then
            local dir = torso.Position - r.Position
            local dist = dir.Magnitude
            if dist > 4 then
                -- Летим к цели
                local du = dir.Unit
                h.WalkSpeed = 49
                h:Move(Vector3.new(du.X, 0, du.Z), false)
                safeSwing()
            elseif dist <= 4 and dist > 2 then
                safeSwing()
                -- Отходим
                local back = (r.Position - torso.Position).Unit
                h.WalkSpeed = 25
                h:Move(Vector3.new(back.X, 0, back.Z), false)
            else
                safeSwing()
                local back = (r.Position - torso.Position).Unit
                h.WalkSpeed = 35
                h:Move(Vector3.new(back.X, 0, back.Z), false)
            end
        end
    end
end

