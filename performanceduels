if not game:IsLoaded() then game.Loaded:Wait() end -- Удаляем старую версию скрипта local C = game:GetService("CoreGui") local U = game:GetService("UserInputService") local R = game:GetService("RunService") local P = game:GetService("Players") local L = P.LocalPlayer if C:FindFirstChild("PerformanceDuels") then C.PerformanceDuels:Destroy() end if C:FindFirstChild("PH") then C.PH:Destroy() end if C:FindFirstChild("PD") then C.PD:Destroy() end local G = Instance.new("ScreenGui") G.Name = "PerformanceDuels" G.Parent = C local S = {AL = false, AR = false, LB = false, DR = false, TN = false} local LP, RP = 1, 1 local WAITING = false local WAIT_START = 0 local WAIT_DUR = 1.8 local WAIT_SIDE = "" local LAST_ATTACK = 0 local lastPosition = nil local tauntLoop = nil -- Координаты local L_START = Vector3.new(-474.7, -5.9, 91.0) local L_END_PLUS = Vector3.new(-483.4, -3.9, 97.3) local L_BACK = Vector3.new(-474.7, -5.9, 91.0) local L_RETURN = Vector3.new(-472.31, -7.09, 26.70) local L_FINAL = Vector3.new(-482.74, -5.13, 24.12) local R_START = Vector3.new(-470.6, -5.9, 34.4) local R_END_PLUS = Vector3.new(-484.2, -3.9, 21.4) local R_BACK = Vector3.new(-475.6, -5.8, 29.3) local R_RETURN = Vector3.new(-474.24, -7.09, 93.00) local R_FINAL = Vector3.new(-482.57, -5.13, 94.51) -- Движение игрока (WASD) local movementKeys = { Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Up, Enum.KeyCode.Left, Enum.KeyCode.Down, Enum.KeyCode.Right } local function checkPlayerMove() for _, key in ipairs(movementKeys) do if U:IsKeyDown(key) then return true end end return false end -- Отключение AUTO LEFT/RIGHT при ручном движении local function handleManualMovement() if checkPlayerMove() then if S.AL then S.AL = false for _, v in pairs(G:GetDescendants()) do if v:IsA("TextButton") and v.Text:find("Auto") and v.Text:find("Left") then v.Text = "Auto\nLeft" v.BackgroundColor3 = Color3.fromRGB(30, 30, 45) v.TextColor3 = Color3.fromRGB(220, 220, 240) end end LP = 1 WAITING = false WAIT_SIDE = "" end if S.AR then S.AR = false for _, v in pairs(G:GetDescendants()) do if v:IsA("TextButton") and v.Text:find("Auto") and v.Text:find("Right") then v.Text = "Auto\nRight" v.BackgroundColor3 = Color3.fromRGB(30, 30, 45) v.TextColor3 = Color3.fromRGB(220, 220, 240) end end RP = 1 WAITING = false WAIT_SIDE = "" end end end local function checkTeleport() local c = L.Character if not c then return false end local r = c:FindFirstChild("HumanoidRootPart") if not r then return false end local currentPos = r.Position if lastPosition then local distance = (currentPos - lastPosition).Magnitude if distance > 50 then return true end end lastPosition = currentPos return false end -- ========== TAUNT FUNCTION ========== local function startTaunt() if tauntLoop then return end tauntLoop = task.spawn(function() while S.TN do pcall(function() local chat = game:GetService("TextChatService") local channel = chat.TextChannels:FindFirstChild("RBXGeneral") if channel then channel:SendAsync("/performance duels") end end) task.wait(0.5) end end) end local function stopTaunt() if tauntLoop then task.cancel(tauntLoop) tauntLoop = nil end end -- ========== DROP FLING ========== local _wfConns = {} local _wfActive = false local function startWalkFling() _wfActive = true table.insert(_wfConns, R.Stepped:Connect(function() if not _wfActive then return end for _, p in ipairs(P:GetPlayers()) do if p ~= L and p.Character then for _, part in ipairs(p.Character:GetChildren()) do if part:IsA("BasePart") then part.CanCollide = false end end end end end)) local co = coroutine.create(function() while _wfActive do R.Heartbeat:Wait() local c = L.Character local root = c and c:FindFirstChild("HumanoidRootPart") if not root then R.Heartbeat:Wait() else local vel = root.Velocity root.Velocity = vel * 10000 + Vector3.new(0, 10000, 0) R.RenderStepped:Wait() if root and root.Parent then root.Velocity = vel end R.Stepped:Wait() if root and root.Parent then root.Velocity = vel + Vector3.new(0, 0.1, 0) end end end end) coroutine.resume(co) table.insert(_wfConns, co) end local function stopWalkFling() _wfActive = false for _, conn in ipairs(_wfConns) do if typeof(conn) == "RBXScriptConnection" then conn:Disconnect() elseif typeof(conn) == "thread" then pcall(task.cancel, conn) end end _wfConns = {} end local function doDrop() startWalkFling() task.delay(0.4, stopWalkFling) end -- ========== ANTI-RAGDOLL ========== local antiRagdollActive = true local antiRagdollConn = nil local function GetChar() return L.Character end local function GetHum() local c = GetChar(); return c and c:FindFirstChildOfClass("Humanoid") end local function GetRoot() local c = GetChar(); return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("UpperTorso")) end local function startAntiRagdoll() if antiRagdollConn then antiRagdollConn:Disconnect() end antiRagdollConn = R.Heartbeat:Connect(function() if not antiRagdollActive then return end local c = GetChar() if not c then return end local root = GetRoot() local hum = GetHum() if hum then local s = hum:GetState() if s == Enum.HumanoidStateType.Physics or s == Enum.HumanoidStateType.Ragdoll or s == Enum.HumanoidStateType.FallingDown then hum:ChangeState(Enum.HumanoidStateType.Running) if workspace.CurrentCamera then workspace.CurrentCamera.CameraSubject = hum end pcall(function() local pm = L.PlayerScripts:FindFirstChild("PlayerModule") if pm then require(pm:FindFirstChild("ControlModule")):Enable() end end) if root then root.Velocity = Vector3.zero root.RotVelocity = Vector3.zero end end end for _, obj in ipairs(c:GetDescendants()) do if obj:IsA("Motor6D") and not obj.Enabled then obj.Enabled = true end end end) end -- ========== UNWALK ========== local unwalkActive = true local unwalkConn = nil local function startUnwalk() if unwalkConn then unwalkConn:Disconnect() end local hum = GetHum() if hum then local anim = hum:FindFirstChildOfClass("Animator") if anim then for _, t in pairs(anim:GetPlayingAnimationTracks()) do pcall(function() t:Stop(0) end) end end end unwalkConn = R.Heartbeat:Connect(function() if not unwalkActive then return end local h = GetHum() if not h then return end local a = h:FindFirstChildOfClass("Animator") if not a then return end for _, t in pairs(a:GetPlayingAnimationTracks()) do pcall(function() t:Stop(0) end) end end) end -- ========== FIND NEAREST ENEMY ========== local function findNearestEnemy() local c = L.Character if not c then return nil, nil end local r = c:FindFirstChild("HumanoidRootPart") if not r then return nil, nil end local nearest, nearestTorso = nil, nil for _, p in ipairs(P:GetPlayers()) do if p ~= L and p.Character then local eh = p.Character:FindFirstChild("HumanoidRootPart") local hum = p.Character:FindFirstChildOfClass("Humanoid") if eh and hum and hum.Health > 0 then local dist = (eh.Position - r.Position).Magnitude if not nearest or dist < (nearest.Position - r.Position).Magnitude then nearest = eh nearestTorso = p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Torso") or eh end end end end return nearest, nearestTorso end -- ========== EQUIP BAT ========== local function equipBat() local c = L.Character if not c then return end local h = c:FindFirstChildOfClass("Humanoid") if not h then return end if c:FindFirstChild("Bat") then return end local bp = L:FindFirstChild("Backpack") if bp then for _, ch in ipairs(bp:GetChildren()) do if ch:IsA("Tool") and ch.Name == "Bat" then h:EquipTool(ch) break end end end end -- ========== SILENT SWING ========== local function silentSwing() if tick() - LAST_ATTACK < 0.4 then return end LAST_ATTACK = tick() local c = L.Character if not c then return end local r = c:FindFirstChild("HumanoidRootPart") if not r then return end local bat = c:FindFirstChild("Bat") if not bat then return end local hd = bat:FindFirstChild("Handle") if not hd then return end for _, p in ipairs(P:GetPlayers()) do if p ~= L and p.Character then local eh = p.Character:FindFirstChild("HumanoidRootPart") local hum = p.Character:FindFirstChildOfClass("Humanoid") if eh and hum and hum.Health > 0 then local dist = (eh.Position - r.Position).Magnitude if dist <= 12 then for _, pt in ipairs(p.Character:GetChildren()) do if pt:IsA("BasePart") then pcall(function() firetouchinterest(hd, pt, 0) end) pcall(function() firetouchinterest(hd, pt, 1) end) end end break end end end end end -- ========== SPEEDS ========== local function getSpeedForPhase(phase) if phase == 1 then return 59 else return 29 end end -- ========== EARLY TURN ========== local function moveWithEarlyTurn(targetPos, currentPos, speed, phase) local dir = (targetPos - currentPos).Unit local distance = (targetPos - currentPos).Magnitude if phase == 1 or phase == 3 then if distance < 10.3 then local earlyTarget = currentPos + dir * (distance + 5.3) dir = (earlyTarget - currentPos).Unit end end return dir end -- ========== AUTO LEFT (6 PHASES) ========== local autoLeftConn = nil local autoLeftPhase = 1 local function startAutoLeft() if autoLeftConn then autoLeftConn:Disconnect() end autoLeftPhase = 1 autoLeftConn = R.Heartbeat:Connect(function() if not S.AL then return end local char = L.Character if not char then return end local hrp = GetRoot() local hum = GetHum() if not hrp or not hum then return end if autoLeftPhase == 1 then local tg = Vector3.new(L_START.X, hrp.Position.Y, L_START.Z) if (tg - hrp.Position).Magnitude < 1 then autoLeftPhase = 2 else local d = L_START - hrp.Position local mv = Vector3.new(d.X, 0, d.Z).Unit hum:Move(mv, false) hrp.AssemblyLinearVelocity = Vector3.new(mv.X * 59, hrp.Velocity.Y, mv.Z * 59) end elseif autoLeftPhase == 2 then local tg = Vector3.new(L_END_PLUS.X, hrp.Position.Y, L_END_PLUS.Z) if (tg - hrp.Position).Magnitude < 1 then WAITING = true WAIT_START = tick() WAIT_SIDE = "LEFT" autoLeftPhase = 3 else local d = L_END_PLUS - hrp.Position local mv = Vector3.new(d.X, 0, d.Z).Unit hum:Move(mv, false) hrp.AssemblyLinearVelocity = Vector3.new(mv.X * 29, hrp.Velocity.Y, mv.Z * 29) end elseif autoLeftPhase == 3 then if tick() - WAIT_START >= WAIT_DUR then WAITING = false autoLeftPhase = 4 end elseif autoLeftPhase == 4 then local tg = Vector3.new(L_BACK.X, hrp.Position.Y, L_BACK.Z) if (tg - hrp.Position).Magnitude < 1 then autoLeftPhase = 5 else local d = L_BACK - hrp.Position local mv = Vector3.new(d.X, 0, d.Z).Unit hum:Move(mv, false) hrp.AssemblyLinearVelocity = Vector3.new(mv.X * 29, hrp.Velocity.Y, mv.Z * 29) end elseif autoLeftPhase == 5 then local tg = Vector3.new(L_RETURN.X, hrp.Position.Y, L_RETURN.Z) if (tg - hrp.Position).Magnitude < 1 then autoLeftPhase = 6 else local d = L_RETURN - hrp.Position local mv = Vector3.new(d.X, 0, d.Z).Unit hum:Move(mv, false) hrp.AssemblyLinearVelocity = Vector3.new(mv.X * 29, hrp.Velocity.Y, mv.Z * 29) end elseif autoLeftPhase == 6 then local tg = Vector3.new(L_FINAL.X, hrp.Position.Y, L_FINAL.Z) if (tg - hrp.Position).Magnitude < 1 then S.AL = false autoLeftPhase = 1 if autoLeftConn then autoLeftConn:Disconnect(); autoLeftConn = nil end else local d = L_FINAL - hrp.Position local mv = Vector3.new(d.X, 0, d.Z).Unit hum:Move(mv, false) hrp.AssemblyLinearVelocity = Vector3.new(mv.X * 29, hrp.Velocity.Y, mv.Z * 29) end end end) end local function stopAutoLeft() if autoLeftConn then autoLeftConn:Disconnect(); autoLeftConn = nil end autoLeftPhase = 1 WAITING = false local hum = GetHum() if hum then hum:Move(Vector3.zero, false) end end -- ========== AUTO RIGHT (6 PHASES) ========== local autoRightConn = nil local autoRightPhase = 1 local function startAutoRight() if autoRightConn then autoRightConn:Disconnect() end autoRightPhase = 1 autoRightConn = R.Heartbeat:Connect(function() if not S.AR then return end local char = L.Character if not char then return end local hrp = GetRoot() local hum = GetHum() if not hrp or not hum then return end if autoRightPhase == 1 then local tg = Vector3.new(R_START.X, hrp.Position.Y, R_START.Z) if (tg - hrp.Position).Magnitude < 1 then autoRightPhase = 2 else local d = R_START - hrp.Position local mv = Vector3.new(d.X, 0, d.Z).Unit hum:Move(mv, false) hrp.AssemblyLinearVelocity = Vector3.new(mv.X * 59, hrp.Velocity.Y, mv.Z * 59) end elseif autoRightPhase == 2 then local tg = Vector3.new(R_END_PLUS.X, hrp.Position.Y, R_END_PLUS.Z) if (tg - hrp.Position).Magnitude < 1 then WAITING = true WAIT_START = tick() WAIT_SIDE = "RIGHT" autoRightPhase = 3 else local d = R_END_PLUS - hrp.Position local mv = Vector3.new(d.X, 0, d.Z).Unit hum:Move(mv, false) hrp.AssemblyLinearVelocity = Vector3.new(mv.X * 29, hrp.Velocity.Y, mv.Z * 29) end elseif autoRightPhase == 3 then if tick() - WAIT_START >= WAIT_DUR then WAITING = false autoRightPhase = 4 end elseif autoRightPhase == 4 then local tg = Vector3.new(R_BACK.X, hrp.Position.Y, R_BACK.Z) if (tg - hrp.Position).Magnitude < 1 then autoRightPhase = 5 else local d = R_BACK - hrp.Position local mv = Vector3.new(d.X, 0, d.Z).Unit hum:Move(mv, false) hrp.AssemblyLinearVelocity = Vector3.new(mv.X * 29, hrp.Velocity.Y, mv.Z * 29) end elseif autoRightPhase == 5 then local tg = Vector3.new(R_RETURN.X, hrp.Position.Y, R_RETURN.Z) if (tg - hrp.Position).Magnitude < 1 then autoRightPhase = 6 else local d = R_RETURN - hrp.Position local mv = Vector3.new(d.X, 0, d.Z).Unit hum:Move(mv, false) hrp.AssemblyLinearVelocity = Vector3.new(mv.X * 29, hrp.Velocity.Y, mv.Z * 29) end elseif autoRightPhase == 6 then local tg = Vector3.new(R_FINAL.X, hrp.Position.Y, R_FINAL.Z) if (tg - hrp.Position).Magnitude < 1 then S.AR = false autoRightPhase = 1 if autoRightConn then autoRightConn:Disconnect(); autoRightConn = nil end else local d = R_FINAL - hrp.Position local mv = Vector3.new(d.X, 0, d.Z).Unit hum:Move(mv, false) hrp.AssemblyLinearVelocity = Vector3.new(mv.X * 29, hrp.Velocity.Y, mv.Z * 29) end end end) end local function stopAutoRight() if autoRightConn then autoRightConn:Disconnect(); autoRightConn = nil end autoRightPhase = 1 WAITING = false local hum = GetHum() if hum then hum:Move(Vector3.zero, false) end end -- ========== MAIN LOOP ========== local function F() -- Проверяем ручное движение игрока handleManualMovement() local c = L.Character if not c then return end local h = GetHum() local r = GetRoot() if not r or not h then return end if S.DR then doDrop() S.DR = false end if checkTeleport() then if S.AL then S.AL = false LP = 1 end if S.AR then S.AR = false RP = 1 end WAITING = false WAIT_SIDE = "" return end if WAITING then if tick() - WAIT_START >= WAIT_DUR then WAITING = false if WAIT_SIDE == "LEFT" and S.AL then LP = 3 end if WAIT_SIDE == "RIGHT" and S.AR then RP = 3 end WAIT_SIDE = "" end return end if S.LB then equipBat() local target, torso = findNearestEnemy() if target and torso then local dir = torso.Position - r.Position local dist = dir.Magnitude if dist > 4 then local du = dir.Unit r.AssemblyLinearVelocity = Vector3.new(du.X * 49, du.Y * 49, du.Z * 49) silentSwing() elseif dist <= 4 and dist > 2 then silentSwing() local back = (r.Position - torso.Position).Unit r.AssemblyLinearVelocity = Vector3.new(back.X * 25, back.Y * 25, back.Z * 25) else silentSwing() local back = (r.Position - torso.Position).Unit r.AssemblyLinearVelocity = Vector3.new(back.X * 35, 35, back.Z * 35) end end end if S.AL then local t = nil if LP == 1 then t = L_START elseif LP == 2 then t = L_END_PLUS elseif LP == 3 then t = L_BACK elseif LP == 4 then t = L_RETURN elseif LP == 5 then t = L_FINAL end if t then local d = (Vector3.new(t.X, r.Position.Y, t.Z) - r.Position).Magnitude if d < 2.5 then if LP == 2 then WAITING = true WAIT_START = tick() WAIT_SIDE = "LEFT" return end if LP < 5 then LP = LP + 1 else S.AL = false WAITING = false WAIT_SIDE = "" LP = 1 end else local sp = getSpeedForPhase(LP) local dir = moveWithEarlyTurn(t, r.Position, sp, LP) h:MoveTo(t) h.WalkSpeed = sp end end end if S.AR then local t = nil if RP == 1 then t = R_START elseif RP == 2 then t = R_END_PLUS elseif RP == 3 then t = R_BACK elseif RP == 4 then t = R_RETURN elseif RP == 5 then t = R_FINAL end if t then local d = (Vector3.new(t.X, r.Position.Y, t.Z) - r.Position).Magnitude if d < 2.5 then if RP == 2 then WAITING = true WAIT_START = tick() WAIT_SIDE = "RIGHT" return end if RP < 5 then RP = RP + 1 else S.AR = false WAITING = false WAIT_SIDE = "" RP = 1 end else local sp = getSpeedForPhase(RP) local dir = moveWithEarlyTurn(t, r.Position, sp, RP) h:MoveTo(t) h.WalkSpeed = sp end end end end -- ========== КНОПКИ ========== local function createSquareButton(txt, y, callback) local btn = Instance.new("TextButton") btn.Size = UDim2.new(0, 85, 0, 70) btn.Position = UDim2.new(1, -100, 0, y) btn.BackgroundColor3 = Color3.fromRGB(30, 30, 45) btn.BorderSizePixel = 0 btn.Text = txt btn.TextColor3 = Color3.fromRGB(220, 220, 240) btn.Font = Enum.Font.GothamBold btn.TextSize = 11 btn.Parent = G local btnCorner = Instance.new("UICorner") btnCorner.CornerRadius = UDim.new(0, 12) btnCorner.Parent = btn local btnStroke = Instance.new("UIStroke") btnStroke.Color = Color3.fromRGB(64, 128, 255) btnStroke.Thickness = 2 btnStroke.Parent = btn local a = false btn.MouseButton1Click:Connect(function() a = not a btn.Text = txt btn.BackgroundColor3 = a and Color3.fromRGB(64, 128, 255) or Color3.fromRGB(30, 30, 45) btn.TextColor3 = a and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(220, 220, 240) callback(a) end) return btn end -- Auto Left (с автоотключением Auto Right и Lock Bat) createSquareButton("Auto\nLeft", 10, function(on) if on then if S.AR then S.AR = false for _, v in pairs(G:GetDescendants()) do if v:IsA("TextButton") and v.Text:find("Auto") and v.Text:find("Right") then v.Text = "Auto\nRight" v.BackgroundColor3 = Color3.fromRGB(30, 30, 45) v.TextColor3 = Color3.fromRGB(220, 220, 240) end end stopAutoRight() end if S.LB then S.LB = false for _, v in pairs(G:GetDescendants()) do if v:IsA("TextButton") and v.Text:find("Lock") then v.Text = "Lock\nBat" v.BackgroundColor3 = Color3.fromRGB(30, 30, 45) v.TextColor3 = Color3.fromRGB(220, 220, 240) end end end S.AL = true LP = 1 WAITING = false WAIT_SIDE = "" lastPosition = nil startAutoLeft() else S.AL = false stopAutoLeft() end end) -- Auto Right (с автоотключением Auto Left и Lock Bat) createSquareButton("Auto\nRight", 90, function(on) if on then if S.AL then S.AL = false for _, v in pairs(G:GetDescendants()) do if v:IsA("TextButton") and v.Text:find("Auto") and v.Text:find("Left") then v.Text = "Auto\nLeft" v.BackgroundColor3 = Color3.fromRGB(30, 30, 45) v.TextColor3 = Color3.fromRGB(220, 220, 240) end end stopAutoLeft() end if S.LB then S.LB = false for _, v in pairs(G:GetDescendants()) do if v:IsA("TextButton") and v.Text:find("Lock") then v.Text = "Lock\nBat" v.BackgroundColor3 = Color3.fromRGB(30, 30, 45) v.TextColor3 = Color3.fromRGB(220, 220, 240) end end end S.AR = true RP = 1 WAITING = false WAIT_SIDE = "" lastPosition = nil startAutoRight() else S.AR = false stopAutoRight() end end) -- Lock Bat (с автоотключением Auto Left и Auto Right) createSquareButton("Lock\nBat", 170, function(on) if on then if S.AL then S.AL = false for _, v in pairs(G:GetDescendants()) do if v:IsA("TextButton") and v.Text:find("Auto") and v.Text:find("Left") then v.Text = "Auto\nLeft" v.BackgroundColor3 = Color3.fromRGB(30, 30, 45) v.TextColor3 = Color3.fromRGB(220, 220, 240) end end stopAutoLeft() end if S.AR then S.AR = false for _, v in pairs(G:GetDescendants()) do if v:IsA("TextButton") and v.Text:find("Auto") and v.Text:find("Right") then v.Text = "Auto\nRight" v.BackgroundColor3 = Color3.fromRGB(30, 30, 45) v.TextColor3 = Color3.fromRGB(220, 220, 240) end end stopAutoRight() end S.LB = on else S.LB = false end end) createSquareButton("Drop", 250, function(on) S.DR = on end) createSquareButton("Taunt", 330, function(on) S.TN = on if on then startTaunt() else stopTaunt() end end) U.JumpRequest:Connect(function() local c = L.Character local r = c and c:FindFirstChild("HumanoidRootPart") if r then r.Velocity = Vector3.new(r.Velocity.X, 50, r.Velocity.Z) end end) startAntiRagdoll() startUnwalk() R.Heartbeat:Connect(F) p